# Dependencies and build output
node_modules/
dist/
.next/
coverage/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Backend runtime data (PostgreSQL cluster + uploaded media)
server/.pgdata/
server/uploads/*
!server/uploads/.gitkeep

# Agent skill packs installed locally (npx skills add …) — not part of the app
.agents/
.claude/
agent/
skills-lock.json

# Logical backups written by the server
server/.backups/

# playwright: run artefacts, never the goldens themselves
test-results/
playwright-report/
blob-report/

# Generated serverless panel build
panel-output/
server/panel-static/
