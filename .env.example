# ------------------------------------------------------------------
# KolbeVintage backend (Fastify + PostgreSQL)
# Copy to `.env` or export these before `npm run dev` / `npm start`.
# ------------------------------------------------------------------

# HTTP server (the Vite dev server proxies /api and /uploads here)
HOST=0.0.0.0
PORT=4000

# PostgreSQL
# Leave DATABASE_URL empty to launch the bundled embedded PostgreSQL
# (binaries from `embedded-postgres`, data in server/.pgdata).
# DATABASE_URL=postgres://kolbe:kolbe@127.0.0.1:5432/kolbevintage
# PGDATA_DIR=server/.pgdata
# PGPORT=55432
# PGDATABASE=kolbevintage
# PGUSER=kolbe
# PGPASSWORD=kolbe

# Uploaded product images (served at /uploads/*)
# UPLOADS_DIR=server/uploads

# Set to 1 to let Fastify serve the built SPA from dist/ (production)
# SERVE_STATIC=1

# Set to 1 to require an admin session cookie for state writes,
# uploads and admin-only reads (recommended for production)
# REQUIRE_ADMIN_AUTH=1

# Separate passcode that promotes an admin session to the protected
# `superadmin` subject. Refund approval is fail-closed: with this empty,
# nobody can enable live refunds (POST /api/commerce/admin/elevate).
# SUPERADMIN_PASSCODE=

# Commerce core defaults live in the `commerce_settings` table and can be
# changed from the admin panel (tab "تجارت و پرداخت"). Among them:
# reservation hold (10 min), payment window (15 min), quote TTL (10 min),
# flat/express shipping, free-shipping threshold on the post-discount
# subtotal, discount stacking (off) and the store-wide BNPL gate (off).

# Frontend override when the API lives on another origin at build time
# VITE_API_BASE=

# ------------------------------------------------------------------
# Optional integrations. Each one fails closed: with the variable
# unset the panel says so, and no feature pretends to work.
# ------------------------------------------------------------------

# Review mode: open the panel with no passcode and accept every request as the
# owner. Meant for looking around a sandbox/preview where the browser may keep
# no cookies. NEVER set this on a real shop — anyone who reaches the panel could
# change prices, orders and settings. The panel shows a red banner while it is on.
# PANEL_OPEN_ACCESS=1

# SMS (decisions 46 + 72). The endpoint receives one POST per message with
# `{ to, body, sender }`; authentication is either a bearer token or an
# HMAC-SHA256 signature of the body under SMS_PROVIDER_SECRET.
# SMS_PROVIDER_URL=https://api.sms-provider.example/v1/messages
# SMS_PROVIDER_TOKEN=
# SMS_PROVIDER_SECRET=
# SMS_SENDER=30000000

# The real payment gateway. Nothing is taken until PAYMENT_GATEWAY_URL is set:
# while it is empty the provider is refused (503 provider_not_configured) and the
# shop keeps using the mock gateway. The adapter speaks two calls —
#   POST <url>/initiate { reference, amount, currency, description, callbackUrl, returnUrl }
#        → { providerRef, redirectUrl?, instructions? }
#   POST <url>/verify   { reference, providerRef }
#        → { status: settled|pending|failed|cancelled, amount, providerRef }
# A callback is never proof: even a signed one only triggers /verify, and the
# amount it reports must match the order to the rial.
# PAYMENT_GATEWAY_URL=https://gateway.example/v1
# PAYMENT_GATEWAY_TOKEN=
# PAYMENT_GATEWAY_SECRET=            # HMAC key for requests and callback signatures
# PAYMENT_GATEWAY_REFUNDS=0          # set to 1 only if the provider really reverses
# PUBLIC_BASE_URL=https://shop.example  # where the gateway calls back and returns the shopper

# Cloud copy of every backup (decisions 11 + 85). A plain authenticated PUT to
# <endpoint>/<file>.gz. Without it backups stay local and record
# cloud_status = not_configured.
# BACKUP_CLOUD_ENDPOINT=https://storage.example/bucket/kolbe
# BACKUP_CLOUD_TOKEN=
# BACKUP_DIR=server/.backups
# BACKUP_HOUR=3
# BACKUP_KEEP=14

# The panel on its own host (decision 86). When set, a panel URL opened on the
# shop host redirects here; leave it empty and nothing changes.
# ADMIN_BASE_URL=https://admin.shop.example

# Browser origins allowed to call the API from another host (comma separated).
# CORS_ALLOWED_ORIGINS=https://shop.example,https://admin.shop.example
