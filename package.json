{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web,panel -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:panel\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "api": "tsx server/src/index.ts",
    "seed": "node scripts/gen-seed.mjs",
    "build": "vite build",
    "preview": "npm run build && SERVE_STATIC=1 tsx server/src/index.ts",
    "preview:static": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "start": "SERVE_STATIC=1 REQUIRE_ADMIN_AUTH=1 NODE_ENV=production tsx server/src/index.ts",
    "test:commerce": "node --import tsx --test --test-force-exit --test-timeout=30000 server/test/commerce.test.ts",
    "test": "npm run test:sms && npm run test:commerce && npm run test:rbac",
    "audit:contrast": "node scripts/contrast-check.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "audit:purge": "node scripts/purge-dryrun.mjs",
    "audit:widgets": "node scripts/widget-audit.mjs",
    "audit": "npm run audit:contrast && npm run audit:mobile && npm run audit:widgets && npm run lint:ui && npm run lint:responsive && npm run lint:classes && npm run audit:routes",
    "test:rbac": "node --import tsx --test --test-force-exit --test-timeout=30000 server/test/rbac.test.ts",
    "restore": "node --import tsx scripts/restore-backup.mjs",
    "clear-demo": "node --import tsx scripts/clear-demo-data.mjs",
    "lint:ui": "node scripts/ui-audit.mjs",
    "goldens": "node scripts/goldens-preflight.mjs && playwright test -c tests/visual/playwright.config.ts",
    "goldens:update": "node scripts/goldens-preflight.mjs && playwright test -c tests/visual/playwright.config.ts --update-snapshots",
    "skills:install": "node scripts/install-skills.mjs",
    "lint:responsive": "node scripts/responsive-audit.mjs",
    "lint:classes": "node scripts/class-audit.mjs",
    "smoke:panel": "tsx scripts/panel-smoke.mjs",
    "audit:a11y": "tsx scripts/a11y-audit.mjs",
    "audit:routes": "node scripts/routing-audit.mjs",
    "dev:panel": "npm --prefix fashion-e-commerce-admin-development run dev -- --hostname 127.0.0.1 --port 3000",
    "build:panel": "npm --prefix fashion-e-commerce-admin-development run build",
    "start:panel": "npm --prefix fashion-e-commerce-admin-development run start -- --hostname 127.0.0.1 --port 3000",
    "start:all": "concurrently -k -n api,panel \"npm:start\" \"npm:start:panel\"",
    "test:live-panel": "cd fashion-e-commerce-admin-development && ../node_modules/.bin/tsx scripts/live-panel-smoke.tsx",
    "test:live-catalog": "node scripts/live-catalog-smoke.mjs",
    "test:store-theme": "node scripts/store-theme-smoke.mjs",
    "production:check": "node scripts/production-check.mjs",
    "test:production-check": "node scripts/test-production-check.mjs",
    "provision:store": "tsx scripts/provision-store.ts",
    "test:store-boot": "node scripts/store-boot-smoke.mjs",
    "test:live-journal": "node scripts/live-journal-smoke.mjs",
    "test:size-guide": "tsx scripts/size-guide-smoke.tsx",
    "test:browser-store": "node scripts/browser-store-smoke.mjs",
    "test:browser-card-canvas": "node scripts/browser-card-canvas-smoke.mjs",
    "test:browser-style-wizard": "node scripts/browser-style-wizard-smoke.mjs",
    "test:browser-home-panel": "node scripts/browser-home-panel-smoke.mjs",
    "test:browser-order-page": "node scripts/browser-order-page-smoke.mjs",
    "test:browser-visual-studio": "node scripts/browser-visual-studio-smoke.mjs",
    "test:browser-product-video": "node scripts/browser-product-video-smoke.mjs",
    "test:browser-returns-page": "node scripts/browser-returns-page-smoke.mjs",
    "test:browser-journal-category": "node scripts/browser-journal-category-smoke.mjs",
    "test:browser-journal-video": "node scripts/browser-journal-video-smoke.mjs",
    "test:browser-admin-mfa": "node --import tsx scripts/browser-admin-mfa-smoke.mjs",
    "test:browser-admin-sms-mfa": "node --import tsx scripts/browser-admin-sms-mfa-smoke.mjs",
    "test:browser-customer-pages": "node scripts/browser-customer-pages-smoke.mjs",
    "test:browser-print-pages": "node scripts/browser-print-pages-smoke.mjs",
    "recover:panel-path": "tsx scripts/reset-panel-path.ts",
    "test:browser-panel-path": "node --import tsx scripts/browser-panel-path-smoke.mjs",
    "test:browser-fulfillment": "node scripts/browser-fulfillment-smoke.mjs",
    "test:browser-dashboard-summary": "node scripts/browser-dashboard-summary-smoke.mjs",
    "test:sms": "node --import tsx --test server/test/melipayamak-otp.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/http-proxy": "^11.6.6",
    "@fastify/multipart": "^10.1.7",
    "@fastify/reply-from": "^12.8.1",
    "@fastify/static": "^10.1.8",
    "@puckeditor/core": "0.24.0",
    "clsx": "2.1.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "fastify": "^5.12.8",
    "lossless-json": "^4.3.3",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.4.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
